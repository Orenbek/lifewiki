---
const { toc } = Astro.locals.starlightRoute;
const label = Astro.locals.t('tableOfContents.onThisPage');
---

<wiki-content-layout class="wiki-columns" data-state="closed">
	{
		toc && (
			<>
				<button class="toc-open print:hidden" type="button" data-toc-toggle aria-expanded="false" aria-controls="wiki-right-sidebar" aria-label={'展开' + label} title={'展开' + label}>
					<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true">
						<path d="M4 6h16M4 12h12M4 18h8" />
					</svg>
				</button>
				<aside id="wiki-right-sidebar" class="wiki-right-rail print:hidden" inert aria-hidden="true">
					<div class="wiki-right-sticky"><slot name="right-sidebar" /></div>
				</aside>
			</>
		)
	}
	<div class="wiki-main-pane"><slot /></div>
</wiki-content-layout>

<script>
	class WikiContentLayout extends HTMLElement {
		connectedCallback() {
			if (this.dataset.ready) return;
			this.dataset.ready = 'true';
			const panel = this.querySelector<HTMLElement>('.wiki-right-rail');
			const opener = this.querySelector<HTMLButtonElement>('.toc-open');
			if (!panel || !opener) return;
			let openingFrame: number | undefined;
			let closeTimer: ReturnType<typeof setTimeout> | undefined;
			const finishClosing = () => {
				if (this.dataset.state === 'closing') this.dataset.state = 'closed';
			};
			const setExpanded = (expanded: boolean) => {
				clearTimeout(closeTimer);
				if (openingFrame !== undefined) cancelAnimationFrame(openingFrame);
				this.querySelectorAll('[data-toc-toggle]').forEach((button) => {
					button.setAttribute('aria-expanded', String(expanded));
				});
				opener.inert = expanded;
				opener.setAttribute('aria-hidden', String(expanded));
				if (!expanded && panel.contains(document.activeElement)) opener.focus({ preventScroll: true });
				panel.inert = !expanded;
				panel.setAttribute('aria-hidden', String(!expanded));
				if (expanded) {
					if (this.dataset.state === 'closed') {
						this.dataset.state = 'opening';
						// Resolve display:none at zero width before changing the transition target.
						void panel.offsetWidth;
						openingFrame = requestAnimationFrame(() => {
							this.dataset.state = 'open';
						});
					} else {
						this.dataset.state = 'open';
					}
					panel.querySelector<HTMLButtonElement>('[data-toc-toggle]')?.focus({ preventScroll: true });
				} else {
					this.dataset.state = 'closing';
					const duration = parseFloat(getComputedStyle(panel).transitionDuration) * 1000;
					if (duration === 0) finishClosing();
					else closeTimer = setTimeout(finishClosing, duration + 50);
				}
			};
			this.querySelectorAll('[data-toc-toggle]').forEach((button) => {
				button.addEventListener('click', () => setExpanded(this.dataset.state !== 'open' && this.dataset.state !== 'opening'));
			});
			panel.addEventListener('transitionend', (event) => {
				if (event.target === panel && event.propertyName === 'flex-basis') finishClosing();
			});
			this.addEventListener('keydown', (event) => {
				if (event.key === 'Escape' && (this.dataset.state === 'open' || this.dataset.state === 'opening')) setExpanded(false);
			});
		}
	}
	if (!customElements.get('wiki-content-layout')) customElements.define('wiki-content-layout', WikiContentLayout);
</script>

<style>
	.wiki-columns {
		display: block;
		--wiki-toc-width: 21.25rem;
		--wiki-toc-duration: 380ms;
	}
	:global(.main-frame) {
		--sl-mobile-toc-height: 0rem;
	}
	.wiki-main-pane {
		isolation: isolate;
		min-width: 0;
	}
	.wiki-right-rail,
	.toc-open {
		display: none;
	}
	@media (min-width: 72rem) {
		.wiki-columns {
			display: flex;
			align-items: stretch;
		}
		.wiki-main-pane {
			order: 1;
			flex: 1 1 0;
		}
		.wiki-right-rail {
			display: block;
			order: 2;
			flex: 0 0 0px;
			min-width: 0;
			overflow: clip;
			transition: flex-basis var(--wiki-toc-duration) ease;
		}
		.wiki-columns[data-state='closed'] > .wiki-right-rail {
			display: none;
		}
		.wiki-columns[data-state='open'] > .wiki-right-rail {
			flex-basis: var(--wiki-toc-width);
		}
		.wiki-right-sticky {
			position: sticky;
			top: var(--sl-nav-height);
			width: var(--wiki-toc-width);
			max-height: calc(100vh - var(--sl-nav-height));
			overflow-x: hidden;
			overflow-y: auto;
			scrollbar-width: thin;
			border-inline-start: 1px solid var(--sl-color-hairline);
			opacity: 0;
			transform: translateX(100%);
			transition: transform var(--wiki-toc-duration) ease, opacity var(--wiki-toc-duration) ease;
		}
		.wiki-columns[data-state='open'] .wiki-right-sticky {
			opacity: 1;
			transform: translateX(0);
		}
		.toc-open {
			position: fixed;
			inset-block-start: calc(var(--sl-nav-height) + 1rem);
			inset-inline-end: 1rem;
			z-index: 5;
			display: grid;
			place-items: center;
			width: 2.25rem;
			height: 2.25rem;
			padding: 0;
			border: 1px solid var(--sl-color-hairline);
			border-radius: 0.5rem;
			background: var(--sl-color-bg-nav);
			color: var(--sl-color-text-accent);
			box-shadow: var(--sl-shadow-sm);
			cursor: pointer;
			opacity: 1;
			transform: translateX(0);
			transition: opacity var(--wiki-toc-duration) ease, transform var(--wiki-toc-duration) ease;
		}
		.wiki-columns[data-state='open'] > .toc-open {
			opacity: 0;
			transform: translateX(0.5rem);
			pointer-events: none;
		}
		.toc-open:hover {
			background: var(--sl-color-gray-6);
		}
		.toc-open:focus-visible {
			outline: 2px solid var(--sl-color-accent);
			outline-offset: 3px;
		}
		/* Override the stock PageSidebar's global navigation dimensions locally. */
		.wiki-right-rail :global(.right-sidebar-panel) {
			padding: 1rem 0.5rem;
		}
		.wiki-right-rail :global(.right-sidebar-panel > .sl-container) {
			width: 100%;
			max-width: none;
		}
	}
	@media (prefers-reduced-motion: reduce) {
		.wiki-right-sticky,
		.toc-open {
			transform: none;
			transition: none;
		}
	}
</style>
